# Centralized Configuration for Local LLM Chatbot + Web Scraper RAG

# Model Settings
BASE_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
PORT=5000

# Web Access & Scraping
WEB_ACCESS_ENABLED=true
REQUEST_TIMEOUT=10.0
MAX_RESPONSE_SIZE=2097152
MAX_REDIRECTS=5
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 (ResearchBot/1.0; LocalLLM)
REQUEST_DELAY=0.5

# Chunking & Storage
CHUNK_SIZE=600
CHUNK_OVERLAP=120
MAX_EXTRACTED_LENGTH=150000
RAG_DATA_DIR=./data
RAG_DB_PATH=./data/rag_storage.db

# Retrieval
RETRIEVAL_TOP_K=3
SIMILARITY_THRESHOLD=0.05
MAX_CONTEXT_LENGTH=2500

# Web Discovery Provider ('duckduckgo', 'brave', 'serpapi', 'mock')
SEARCH_PROVIDER=duckduckgo
MAX_SEARCH_RESULTS=3

# Optional API Keys (Never commit real keys to source control!)
BRAVE_API_KEY=
SERPAPI_API_KEY=

# Logging
LOG_LEVEL=INFO
